# Database
DATABASE_URL=postgresql://bunq:bunq_secret@db:5432/bunq_overview

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=  # openssl rand -base64 32

# Keycloak
KEYCLOAK_CLIENT_ID=bunq-overview-web
KEYCLOAK_CLIENT_SECRET=  # from Keycloak admin console
KEYCLOAK_ISSUER=http://localhost:8180/realms/bunq-overview

# bunq API
BUNQ_API_KEY=  # your bunq API key
BUNQ_API_URL=https://api.bunq.com/v1
BUNQ_IBAN=  # your IBAN

# Admin
ADMIN_USER_ID=  # Keycloak user sub claim
